# BlickPUNKT Archiv – Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an.

# Quell-URL für den Ausgaben-Scan
SOURCE_URL=https://www.unser-blickpunkt.de/blickpunkt-ausgaben/

# Datenbank-Pfad (relativ zum Projektverzeichnis)
DATABASE_PATH=data/archive.db

# PDF-Speicherort
PDF_DIR=data/pdfs

# Wartezeit zwischen Downloads in Sekunden
DOWNLOAD_DELAY=3

# Optional: Anthropic API Key für KI-Kategorisierung
# Wenn leer, wird nur regelbasierte Kategorisierung verwendet.
ANTHROPIC_API_KEY=

# Server-Einstellungen
HOST=127.0.0.1
PORT=8000

# ── Supabase (für sync_to_supabase.py) ──────────────────────
# Projekt-URL aus dem Supabase Dashboard (Settings → API)
SUPABASE_URL=https://xxx.supabase.co

# Anon/Public Key (nur lesen – für das Web-Frontend)
SUPABASE_KEY=eyJ...

# Service-Role Key (lesen + schreiben – nur lokal verwenden, nie committen!)
SUPABASE_SERVICE_KEY=eyJ...
